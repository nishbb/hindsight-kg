# Copy to .env and fill in. Never commit .env.

# OpenAI-compatible LLM endpoint for the audit agent (e.g. NVIDIA NIM at build.nvidia.com)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=
LLM_API_KEY=

# NCBI E-utilities (optional, raises rate limits): https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
NCBI_EMAIL=
